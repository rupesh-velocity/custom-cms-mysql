generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "mysql"
}

model Post {
  id                Int        @id @default(autoincrement())
  title             String
  slug              String     @unique
  contentHtml       String @db.LongText
  contentText       String @db.LongText
  metaDescription   String @db.LongText
  focusKeyword      String
  seoTitle          String?
  redirectUrl       String?
  redirectType      String?
  noIndex           Boolean    @default(false)
  seoRobots         String?
  seoAdvancedRobots String?
  status            String     @default("Draft")
  visibility        String     @default("Public")
  password          String?
  schemaJson        String? @db.LongText
  seoScore          Int        @default(0)
  isPillar          Boolean    @default(false)
  authorId          Int?
  author            User?      @relation(fields: [authorId], references: [id])
  categories        Category[]
  tags              Tag[]
  featuredImage     String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  publishedAt       DateTime?
}

model Page {
  id                Int       @id @default(autoincrement())
  title             String
  slug              String    @unique
  contentHtml       String @db.LongText
  contentText       String @db.LongText
  metaDescription   String @db.LongText
  focusKeyword      String
  seoTitle          String?
  redirectUrl       String?
  redirectType      String?
  noIndex           Boolean   @default(false)
  seoRobots         String?
  seoAdvancedRobots String?
  status            String    @default("Draft")
  visibility        String    @default("Public")
  password          String?
  hideTitle         Boolean   @default(false)
  schemaJson        String? @db.LongText
  seoScore          Int       @default(0)
  isPillar          Boolean   @default(false)
  authorId          Int?
  author            User?     @relation(fields: [authorId], references: [id])
  featuredImage     String?
  heroDescription   String? @db.LongText
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  publishedAt       DateTime?
}

model User {
  id              Int                @id @default(autoincrement())
  username        String             @unique
  email           String             @unique
  password        String
  firstName       String?
  lastName        String?
  role            String             @default("Subscriber")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  posts           Post[]
  pages           Page[]
  orders          Order[]
  courses         UserCourseAccess[]
  createdCourses  Course[]
  createdProducts Product[]
  forms           Form[]
}

model Course {
  id              Int                @id @default(autoincrement())
  title           String
  slug            String             @unique
  contentHtml     String? @db.LongText
  contentText     String? @db.LongText
  videos          Json?              @default("[]")
  metaDescription String? @db.LongText
  focusKeyword    String?
  status          String             @default("Draft")
  price           Float              @default(0)
  salePrice       Float?
  featuredImage   String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  authorId        Int?
  author          User?              @relation(fields: [authorId], references: [id])
  products        Product[]
  userAccess      UserCourseAccess[]
}

model UserCourseAccess {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
}

model Setting {
  key       String   @id
  value     String? @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Menu {
  id        Int        @id @default(autoincrement())
  name      String
  slug      String     @unique
  items     MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model MenuItem {
  id        Int        @id @default(autoincrement())
  label     String
  url       String
  order     Int        @default(0)
  menuId    Int
  menu      Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parentId  Int?
  parent    MenuItem?  @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  MenuItem[] @relation("MenuHierarchy")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Media {
  id        Int      @id @default(autoincrement())
  filename  String
  url       String
  mimeType  String
  size      Int
  altText   String?
  createdAt DateTime @default(now())
}

model Redirection {
  id             Int       @id @default(autoincrement())
  sourceUrl      String @db.LongText
  ignoreCase     Boolean   @default(false)
  destinationUrl String @db.LongText
  redirectType   String    @default("301") // 301, 302, 307, 410, 451
  status         Boolean   @default(true) // Active (true) or Deactivated (false)
  hits           Int       @default(0)
  lastAccessed   DateTime?
  category       String    @default("Uncategorized")
  isTrashed      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model NotFoundLog {
  id           Int      @id @default(autoincrement())
  url          String   @unique
  hits         Int      @default(1)
  lastAccessed DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String     @unique
  description String? @db.LongText
  parentId    Int?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  posts       Post[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Tag {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String? @db.LongText
  posts       Post[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- E-COMMERCE MODELS ---

model Product {
  id               Int      @id @default(autoincrement())
  title            String
  slug             String   @unique
  description      String? @db.LongText
  shortDescription String? @db.LongText
  type             String   @default("SIMPLE") // SIMPLE or VARIABLE
  price            Float    @default(0)
  salePrice        Float?
  sku              String?  @unique
  manageStock      Boolean  @default(false)
  stockQuantity    Int      @default(0)
  status           String   @default("Draft") // Draft, Published
  featuredImage    String?
  galleryImages    String? @db.LongText // JSON string of image URLs
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  authorId         Int?
  author           User?    @relation(fields: [authorId], references: [id])

  attributes     ProductAttribute[]
  variations     ProductVariation[]
  orderItems     OrderItem[]
  categories     ProductCategory[]
  linkedCourseId Int?
  linkedCourse   Course?            @relation(fields: [linkedCourseId], references: [id], onDelete: SetNull)
}

model ProductCategory {
  id          Int               @id @default(autoincrement())
  name        String
  slug        String            @unique
  description String? @db.LongText
  parentId    Int?
  parent      ProductCategory?  @relation("ProductCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    ProductCategory[] @relation("ProductCategoryHierarchy")
  products    Product[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model ProductAttribute {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String // e.g., "Size", "Color"
  options   String @db.LongText // JSON string array of options e.g. ["Small", "Medium", "Large"]
  visible   Boolean @default(true) // Visible on the product page
  variation Boolean @default(false) // Used for variations
  isGlobal  Boolean @default(false) // Whether this was imported from a Global Attribute
}

model GlobalAttribute {
  id        Int                   @id @default(autoincrement())
  name      String
  slug      String                @unique
  terms     GlobalAttributeTerm[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
}

model GlobalAttributeTerm {
  id          Int             @id @default(autoincrement())
  attributeId Int
  attribute   GlobalAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  name        String
  slug        String          @unique
  description String? @db.LongText
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ProductVariation {
  id            Int         @id @default(autoincrement())
  productId     Int
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributes    String @db.LongText // JSON string mapping attribute names to selected options e.g. {"Size": "Large", "Color": "Red"}
  price         Float
  salePrice     Float?
  sku           String?     @unique
  manageStock   Boolean     @default(false)
  stockQuantity Int         @default(0)
  orderItems    OrderItem[]
}

model Order {
  id          Int    @id @default(autoincrement())
  orderNumber String @unique
  status      String @default("PENDING") // PENDING, PROCESSING, COMPLETED, CANCELLED
  totalAmount Float
  currency    String @default("USD")

  customerEmail String
  customerId    Int?
  customer      User?  @relation(fields: [customerId], references: [id], onDelete: SetNull)

  billingAddress  String @db.LongText // JSON string
  shippingAddress String @db.LongText // JSON string

  paymentMethod String? // "STRIPE", "PAYPAL", "COD"
  paymentId     String? // Transaction ID from gateway

  shippingMethod String?
  shippingCost   Float   @default(0)

  items OrderItem[]
  notes OrderNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id      Int   @id @default(autoincrement())
  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  variationId Int?
  variation   ProductVariation? @relation(fields: [variationId], references: [id], onDelete: SetNull)

  name     String // Snapshot of product name at purchase
  quantity Int
  price    Float // Snapshot of price at purchase
  total    Float
}

model OrderNote {
  id             Int      @id @default(autoincrement())
  orderId        Int
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  content        String @db.LongText
  isCustomerNote Boolean  @default(false) // If true, customer can see it
  createdAt      DateTime @default(now())
}

model ShippingZone {
  id        Int              @id @default(autoincrement())
  name      String
  regions   String @db.LongText // JSON string of country/state codes
  methods   ShippingMethod[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model ShippingMethod {
  id         Int          @id @default(autoincrement())
  zoneId     Int
  zone       ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name       String // "Flat Rate", "Free Shipping"
  type       String // "FLAT_RATE", "FREE_SHIPPING"
  cost       Float        @default(0)
  conditions String? @db.LongText // JSON string for free shipping thresholds, etc.
  enabled    Boolean      @default(true)
}

model TaxRate {
  id        Int      @id @default(autoincrement())
  country   String // e.g. "US"
  state     String? // e.g. "CA" or "*"
  city      String? // e.g. "Los Angeles" or "*"
  zip       String? // e.g. "90210" or "*"
  rate      Float // e.g. 7.25
  name      String // e.g. "State Tax"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- FORM MODELS ---

model Form {
  id                Int              @id @default(autoincrement())
  title             String
  shortcode         String           @unique
  fields            String @db.LongText // JSON string representing fields
  settings          String? @db.LongText // JSON string for form-level settings
  notificationEmail String?
  status            String           @default("Published")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  authorId          Int?
  author            User?            @relation(fields: [authorId], references: [id])
  submissions       FormSubmission[]
}

model FormSubmission {
  id        Int      @id @default(autoincrement())
  formId    Int
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  data      String @db.LongText // JSON string of submitted data
  status    String   @default("Active") // Active, Spam, Trash
  isRead    Boolean  @default(false)
  isStarred Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SchemaTemplate {
  id        Int      @id @default(autoincrement())
  name      String
  schema    String @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
